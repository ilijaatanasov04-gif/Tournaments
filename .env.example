# Copy to `.env` (same directory as docker-compose.yml) and adjust:
#     cp .env.example .env
#
# docker-compose.yml contains no values at all — everything lives here and is
# injected into the containers via `env_file`. For production you MUST change
# SECRET_KEY and POSTGRES_PASSWORD.

# --- Database ---
POSTGRES_USER=tournament_user
POSTGRES_PASSWORD=tournament_pass
POSTGRES_DB=tournament_db

# --- Backend ---
# Must match the POSTGRES_* values above; `db` is the compose service name.
DATABASE_URL=postgresql://tournament_user:tournament_pass@db:5432/tournament_db
# Secret used to sign JWTs. Generate one with:  openssl rand -hex 32
SECRET_KEY=change-me-in-production
# Set to "production" outside local dev; the backend then refuses to start
# without a real SECRET_KEY.
ENV=dev
# Only needed for the Vite dev server (npm run dev), which calls the backend
# cross-origin. In Docker the frontend proxies /api itself, so it is same-origin.
CORS_ORIGINS=http://localhost:5173

# --- Ports on the host machine ---
BACKEND_PORT=8000
FRONTEND_PORT=3000
