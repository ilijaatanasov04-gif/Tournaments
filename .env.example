# Copy to `.env` (same directory as docker-compose.yml) and adjust.
# Every variable has a working default for local development — for production
# you MUST set SECRET_KEY, POSTGRES_PASSWORD, ENV and CORS_ORIGINS.

# --- Database ---
POSTGRES_USER=tournament_user
POSTGRES_PASSWORD=tournament_pass
POSTGRES_DB=tournament_db

# --- Backend ---
# Secret used to sign JWTs. Generate one with:  openssl rand -hex 32
SECRET_KEY=change-me-in-production
# Set to "production" outside local dev; the backend then refuses to start
# without a real SECRET_KEY.
ENV=dev
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Ports on the host machine ---
BACKEND_PORT=8000
FRONTEND_PORT=3000
